# DeepSeek diagnosis and report generation (project owner)
DIAGNOSIS_AGENT_PROVIDER=dashscope
DIAGNOSIS_AGENT_MODEL=deepseek-v4-pro
DIAGNOSIS_AGENT_API_KEY=
DIAGNOSIS_AGENT_BASE_URL=
DIAGNOSIS_AGENT_REASONING_EFFORT=high

# PR #6: DashScope/Qwen document analysis and knowledge processing
DOCUMENT_AGENT_PROVIDER=dashscope
DOCUMENT_AGENT_MODEL=qwen-plus
DOCUMENT_AGENT_API_KEY=
DOCUMENT_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PR #8: Moonshot/Kimi Excel and CSV table Agent
TABLE_AGENT_KIMI_API_KEY=
TABLE_AGENT_KIMI_BASE_URL=https://api.moonshot.cn/v1
TABLE_AGENT_KIMI_MODEL=kimi-k2.6

# Vector knowledge base. Empty key/base URL reuse DOCUMENT_AGENT_* only.
RAG_USE_CHROMA=true
RAG_VECTOR_PROVIDER=chroma
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=90
RAG_TOP_K=4